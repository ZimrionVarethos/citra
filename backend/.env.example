# Environment configuration for Flask Backend
FLASK_ENV=development
SECRET_KEY=dev-secret-key-32-chars-long-change-in-production

# Supabase PostgreSQL Database URL (Supavisor Transaction Pooler format)
# Format: postgresql+psycopg2://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:6543/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres.yhmqyymadyltgwvogfvw:0004025438Zimrion@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OCR Settings
DEBUG_OCR=0
# Optional custom Tesseract binary path on Windows (uncomment if not in PATH):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Port (Render automatically sets PORT environment variable)
PORT=5000
